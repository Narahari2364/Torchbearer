# Copy to .env.local and fill in. Never commit .env.local.
ELEVENLABS_API_KEY=
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=
GEMINI_API_KEY=

# Storage (Amazon S3). Locally, AWS_PROFILE picks the credentials; on Amplify the branch IAM role is used.
S3_BUCKET=
S3_REGION=us-east-1
AWS_PROFILE=default
